# S.W.A.C.H. Navsari - Environment Configuration Example
# Copy this file to .env.local or .env for local frontend development.
# NEVER commit your actual .env file or put service-role secret keys into frontend client variables.

# Supabase Project URL (e.g. https://your-project.supabase.co or http://127.0.0.1:54321 for local Supabase CLI)
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Supabase Anon / Publishable Key (safe for browser client with RLS enabled)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Application Metadata
VITE_APP_NAME="S.W.A.C.H. Navsari"
VITE_MUNICIPALITY_NAME="Navsari Municipal Corporation / Municipality"
VITE_CITY_NAME="Navsari"
VITE_STATE_NAME="Gujarat"
